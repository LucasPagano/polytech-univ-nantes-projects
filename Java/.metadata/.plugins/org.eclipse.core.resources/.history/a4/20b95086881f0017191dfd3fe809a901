package Freemium.users;

import S3_FREEMIUM.BanqueMusique;
import S3_FREEMIUM.Forbidden;

public abstract class Utilisateur {
	
	public Personne personne;

	public Utilisateur(Personne personne){
		this.personne = personne;
	}
	
	public String getFile(int id){
		if (this.droit()){
			try {
				this.personne.nbEcoute++;
				return BanqueMusique.getFile(id);
			} catch (Forbidden e) {
				e.printStackTrace();
				this.personne.nbEcoute--;
				return null;
			}
		} else{
			return null;
		}
	}
	
	protected abstract boolean droit();
	protected void doDailyUpdate(){}
	
	protected void reset(){
		this.personne.nbEcoute = 0;
	}
	
	public abstract void updateMonthly();
	public void updateDaily(){
		reset();
		doDailyUpdate();
	}
	
	public Personne getPersonne() {
		return personne;
	}
}
