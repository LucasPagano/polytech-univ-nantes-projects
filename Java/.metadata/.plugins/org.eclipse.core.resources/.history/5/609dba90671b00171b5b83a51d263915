package Freemium.users;

public class Personne {

	private static int cpt = 0;
	public String nom;
	protected int num;
	protected int favori;
	protected int nbEcoute;
	
	public Personne(String nom){
		this.nom = nom;	
		this.num = cpt++;
		this.favori = 0;
		this.nbEcoute = 0;
	}

	public String getNom() {
		return nom;
	}

	public int getNum() {
		return num;
	}

	public int getFavori() {
		return favori;
	}

	public int getNbEcoute() {
		return nbEcoute;
	}
		
}
