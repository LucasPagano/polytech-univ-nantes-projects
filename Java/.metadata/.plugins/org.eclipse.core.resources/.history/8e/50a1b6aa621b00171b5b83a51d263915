package Freemium;

import java.util.ArrayList;

import Freemium.users.Utilisateur;

public class SytemeFreemiumStreaming {
	
	protected ArrayList<Utilisateur> users = new ArrayList<Utilisateur>();
	protected static int day = 0;
	
	protected Thread runner;
	
	
	public SytemeFreemiumStreaming() {
		runner = new Thread() {
			@Override
			public void run() {
				try {
					while(true){
						System.out.println("Update");
						sleep(1000);
						updateSystem();
					}
				} catch (InterruptedException e) {
					e.printStackTrace();
				}
			}
		};
		runner.start();
	}
	
	protected void updateSystem() {
		day++;
		for(Utilisateur user : users){
			user.updateDaily();
			if(day == 5){
				System.out.println("Monthly update");
				user.updateMonthly();
				day = 0;
			}
		}
	}
	
	public void addUserToSystem(Utilisateur user){
		users.add(user);
	}

}
