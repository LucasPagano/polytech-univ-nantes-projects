package Freemium.users;

import S3_FREEMIUM.CarteBancaire;

public class Personne {

	private static int cpt = 0;
	public String nom;
	protected int num;
	protected int favori;
	protected int nbEcoute;
	
	protected CarteBancaire cb;
	
	public Personne(String nom){
		this.nom = nom;	
		this.num = cpt++;
		this.favori = 0;
		this.nbEcoute = 0;
		this.cb = null;
	}
	
	public Personne(String nom, int numero, int date, int pictogramme){
		this(nom);
		this.cb = new CarteBancaire(numero, date, pictogramme);
	}

	public String getNom() {
		return nom;
	}

	public int getNum() {
		return num;
	}

	public int getFavori() {
		return favori;
	}

	public int getNbEcoute() {
		return nbEcoute;
	}
		
}
